# Kafka connection (for local development)
KAFKA_BROKERS=kafka-keren-mcp-dev-sandbox.d.aivencloud.com:12693

# SSL certificates (file paths for local dev)
KAFKA_SSL_CA=./ca.pem
KAFKA_SSL_CERT=./service.cert
KAFKA_SSL_KEY=./service.key

# Topics to subscribe to (comma-separated)
KAFKA_TOPICS=login-events,order-events,payment-events,shipping-events,user-events,sensor-readings

# Server port
PORT=3000

# When deployed to Aiven, these are injected automatically:
# KAFKA_BOOTSTRAP_SERVER, KAFKA_CA_CERT, KAFKA_ACCESS_CERT, KAFKA_ACCESS_KEY
