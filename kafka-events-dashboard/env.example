# Aiven Kafka Configuration
KAFKA_BROKERS=kafka-aiven-studio-demo-studio-demo.i.aivencloud.com:16872
KAFKA_TOPIC=events
AIVEN_PROJECT=studio-demo
AIVEN_SERVICE=kafka-aiven-studio-demo

# SSL paths (download from Aiven console or use API)
KAFKA_SSL_CA=/path/to/ca.pem
KAFKA_SSL_CERT=/path/to/service.cert
KAFKA_SSL_KEY=/path/to/service.key

# Server
PORT=3000
